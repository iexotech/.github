#!/usr/bin/env bash
# The repo contract: what every IEXO repo must satisfy, by tier.
# Runs in CI and locally. Standard: handbook engineering/GOLDEN_PATH.md.
set -uo pipefail
# shellcheck disable=SC2329  # check functions are called through check()

tier=$(sed -n 's/^tier: *//p' .iexo.yml 2>/dev/null)
failed=0
today=$(date -u +%F)

waived() {
  local line until
  case "$1" in C03|C04|C05|C09) return 1 ;; esac # these can't be waived
  line=$(grep -vE '^[[:space:]]*#' .iexo.yml 2>/dev/null | grep -E "id: *$1([ ,}]|$)" | head -1) || true
  [ -n "$line" ] || return 1
  until=$(printf '%s' "$line" | sed -n 's/.*until: *\([0-9-]*\).*/\1/p')
  if [ -z "$until" ] || ! printf '%s' "$line" | grep -q 'why:'; then
    echo "FAIL $1: waiver needs until and why"; failed=1; return 1
  fi
  if [[ "$today" > "$until" ]]; then
    echo "FAIL $1: waiver expired on $until"; failed=1; return 1
  fi
  echo "skip $1: waived until $until"
}

check() { # id, description, then a command that passes when the rule holds
  local id=$1 desc=$2; shift 2
  if "$@" >/dev/null 2>&1; then
    echo "ok   $id: $desc"
  elif ! waived "$id"; then
    echo "FAIL $id: $desc"; failed=1
  fi
}

workflows() { git ls-files '.github/workflows/*.yml' '.github/workflows/*.yaml'; }

# Each check reads its input into a variable first: with pipefail, grep -q closing a pipe early reports a false failure.
no_tracked_env() { local files; files=$(git ls-files); ! grep -E '(^|/)\.env(\..*)?$' <<<"$files" | grep -v '\.env\.example$' | grep . ; }
no_ai_trailers() { local log; log=$(git log -50 --format=%B); ! grep -iE '^co-authored-by:.*(claude|anthropic|copilot|cursor|chatgpt|openai|gemini)|generated (with|by) .*(claude|copilot|chatgpt)' <<<"$log"; }
no_conflict_leftovers() { local files; files=$(git ls-files); ! grep '\.rej$' <<<"$files" && ! git grep -lE '^(<{7}|>{7}) ' -- . ':!scripts/contract'; }
no_unsafe_triggers() {
  local f
  for f in $(workflows); do
    grep -vE '^[[:space:]]*#' "$f" | grep -qE '(^|[^a-z_])(pull_request_target|issue_comment)([^a-z_]|$)' && return 1
  done
  return 0
}
permissions_declared() {
  local f
  for f in $(workflows); do
    grep -qE '^permissions:' "$f" || return 1
    grep -qE 'permissions: *write-all' "$f" && return 1
  done
  return 0
}
actions_pinned() {
  local f uses
  for f in $(workflows); do
    uses=$(grep -E '^[[:space:]]*(- )?uses:' "$f" | grep -vE 'uses: *(\./|iexotech/)' || true)
    [ -z "$uses" ] && continue
    grep -vE '@[0-9a-f]{40}' <<<"$uses" && return 1
  done
  return 0
}
agent_config_safe() {
  grep -q '@AGENTS.md' CLAUDE.md || return 1
  [ -f .claude/settings.json ] && [ ! -f .mcp.json ] || return 1
  ! grep -qE 'bypassPermissions|enableAllProjectMcpServers|"hooks"' .claude/settings.json
}
ci_runs_checks() { grep -qE '^ +node: true' .github/workflows/ci.yml; }
lockfile() { [ ! -f package.json ] || [ -f pnpm-lock.yaml ]; }
codeowners() { grep -qE '\.github/' .github/CODEOWNERS && grep -q 'AGENTS.md' .github/CODEOWNERS; }

case "$tier" in
  docs|site|app|regulated) echo "tier: $tier" ;;
  *) echo "FAIL C00: .iexo.yml must set tier to docs, site, app or regulated"; exit 1 ;;
esac

check C01 "README.md and .gitignore exist"          test -f README.md -a -f .gitignore
check C02 "AGENTS.md exists"                         test -f AGENTS.md
check C03 "agent config safe: import, settings, no bypass, hooks or MCP" agent_config_safe
check C04 "no tracked .env files"                   no_tracked_env
check C05 "no AI trailers or branding in commits"   no_ai_trailers
check C06 "no template conflict leftovers"          no_conflict_leftovers
check C07 "workflows declare permissions"           permissions_declared
check C08 "third-party actions pinned to full SHA"  actions_pinned
check C09 "no pull_request_target or issue_comment" no_unsafe_triggers

if [ "$tier" != docs ]; then
  check C10 "package.json has a pnpm lockfile"      lockfile
fi
if [ "$tier" = app ] || [ "$tier" = regulated ]; then
  check C11 ".env.example exists"                   test -f .env.example
  check C12 "docs/adr exists"                       test -d docs/adr
  check C13 "docs/runbooks exists"                  test -d docs/runbooks
  check C14 "docs/RELEASES.md exists"               test -f docs/RELEASES.md
  check C15 "docs/READINESS.md exists"              test -f docs/READINESS.md
  check C18 "CI runs code checks (node: true)"      ci_runs_checks
fi
if [ "$tier" = regulated ]; then
  check C16 "threat model and data-flow map exist"  test -f docs/security/THREAT_MODEL.md -a -f docs/security/DATA_FLOW.md
  check C17 "CODEOWNERS covers workflows and agent files" codeowners
fi

# Reminders never fail a build.
for f in $(git ls-files '*.md'); do
  review=$(sed -n 's/.*Review by:\** *\([0-9-]\{10\}\).*/\1/p' "$f" | head -1)
  if [ -n "$review" ] && [[ "$today" > "$review" ]]; then echo "note: $f was due for review on $review"; fi
done

exit "$failed"
